<!-- Scoutsu's look on top of Fluent (see App.axaml): flat greys, thin borders, small radii,
     one accent. The same palette and names the WPF version used. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:OsuScoutNew.Controls">
    <Styles.Resources>
        <SolidColorBrush x:Key="Brush.Window" Color="#202020" />
        <SolidColorBrush x:Key="Brush.Panel" Color="#2B2B2B" />
        <SolidColorBrush x:Key="Brush.List" Color="#262626" />
        <SolidColorBrush x:Key="Brush.RowAlt" Color="#2A2A2A" />
        <SolidColorBrush x:Key="Brush.Header" Color="#323232" />
        <SolidColorBrush x:Key="Brush.Field" Color="#363636" />
        <SolidColorBrush x:Key="Brush.FieldHover" Color="#3E3E3E" />
        <SolidColorBrush x:Key="Brush.Border" Color="#474747" />
        <SolidColorBrush x:Key="Brush.BorderStrong" Color="#5A5A5A" />
        <SolidColorBrush x:Key="Brush.Separator" Color="#3A3A3A" />
        <SolidColorBrush x:Key="Brush.Text" Color="#E2E2E2" />
        <SolidColorBrush x:Key="Brush.TextDim" Color="#B0B0B0" />
        <SolidColorBrush x:Key="Brush.TextMuted" Color="#808080" />
        <SolidColorBrush x:Key="Brush.Accent" Color="#FF66AB" />
        <SolidColorBrush x:Key="Brush.AccentStrong" Color="#D94F8F" />
        <SolidColorBrush x:Key="Brush.Selection" Color="#4A2A3C" />
        <SolidColorBrush x:Key="Brush.Hover" Color="#313131" />

        <!-- Fluent DataGrid colours -->
        <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#2E2E2E" />
        <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="#323232" />
        <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="#B0B0B0" />
        <SolidColorBrush x:Key="DataGridColumnHeaderHoveredBackgroundBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackgroundBrush" Color="#2F2F2F" />
        <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#4A2A3C" />
        <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#553047" />
        <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#4A2A3C" />
        <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#553047" />
        <SolidColorBrush x:Key="DataGridRowHoveredBackgroundColor" Color="#313131" />
        <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
        <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
        <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
        <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
        <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
        <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
        <!-- Column headers. Fluent's own template always reserves 32px for the sort arrow,
             which hid the names of narrow columns (BPM, CS, AR...); here the arrow only takes
             space on the column that's sorted. -->
        <ControlTheme x:Key="{x:Type DataGridColumnHeader}" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="Background" Value="{StaticResource Brush.Header}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="6,0,4,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,1">
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <Path Name="SortIcon" DockPanel.Dock="Right" Width="7" Height="4" Stretch="Fill" Margin="4,0,0,0"
                                  Fill="{StaticResource Brush.Accent}" VerticalAlignment="Center" IsVisible="False" />
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#3A3A3A" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            </Style>
            <Style Selector="^:sortascending /template/ Path#SortIcon">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Data" Value="M 0 4 L 3.5 0 L 7 4 Z" />
            </Style>
            <Style Selector="^:sortdescending /template/ Path#SortIcon">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Data" Value="M 0 0 L 3.5 4 L 7 0 Z" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource Brush.Window}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Segoe UI, Inter" />
    </Style>

    <!-- Buttons: flat, thin border, small radius -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Brush.FieldHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <!-- The one call to action in the window. -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource Brush.AccentStrong}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,5" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Small ✕ beside a filter's value that clears it. -->
    <Style Selector="Button.reset">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Text fields -->
    <Style Selector="TextBox, AutoCompleteBox /template/ TextBox, ComboBox">
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!-- A section heading in the filter panel, and the small grey hints under fields. -->
    <Style Selector="TextBlock.section">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- The map list -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{StaticResource Brush.List}" />
        <Setter Property="RowBackground" Value="{StaticResource Brush.List}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowHeight" Value="24" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="DataGridRow.alt">
        <Setter Property="Background" Value="{StaticResource Brush.RowAlt}" />
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="DataGridCell TextBlock">
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.number">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.stars">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    </Style>

    <!-- Splitter between the filters and the list: a 1px line in a wider grab area. -->
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Rectangle Width="1" Fill="{StaticResource Brush.Separator}" HorizontalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource Brush.AccentStrong}" />
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Height" Value="8" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="#1B1B1B" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="MaxWidth" Value="420" />
    </Style>

    <!-- Range filters: a grey track, the chosen range coloured by Foreground (MainWindow sets
         it to the accent while a filter is set), light grey handles. -->
    <Style Selector="controls|RangeSlider">
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="TrackBrush" Value="{StaticResource Brush.Field}" />
        <Setter Property="ThumbBrush" Value="#CFCFCF" />
        <Setter Property="ThumbHoverBrush" Value="White" />
        <Setter Property="ThumbDragBrush" Value="{StaticResource Brush.Accent}" />
    </Style>
</Styles>
