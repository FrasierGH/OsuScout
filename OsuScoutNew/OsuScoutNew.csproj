<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plain net10.0: the window is Avalonia, so one build runs on Windows and Linux. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>OsuScoutNew.Program</StartupObject>
    <!-- Bindings in the XAML are resolved at run time (no x:DataType needed). -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- THE release number. Bump it in a PR and merging that PR ships it to users
         (see .github/workflows/release.yml). MAJOR.MINOR.PATCH: breaking change /
         new feature / bug fix only. -->
    <Version>1.4.0</Version>

    <!-- What users see. Task Manager and file properties show AssemblyTitle; the exe,
         its shortcuts and the taskbar use ApplicationIcon (regenerate it with
         branding/make_icon.py). The project and exe stay "OsuScoutNew"; the Velopack ID
         (ScoutsuLazer) is set in release.yml. -->
    <Product>Scoutsu</Product>
    <AssemblyTitle>Scoutsu</AssemblyTitle>
    <ApplicationIcon>Assets\scoutsu.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
    <PackageReference Include="Rosu.Net" Version="1.0.4" />
    <!-- Must equal the vpk version in .github/workflows/release.yml, and must be a
         version nuget.org really has: a missing one silently resolves to the next
         higher, which is how 0.0.866 became 0.0.869 without anyone choosing it. -->
    <PackageReference Include="Velopack" Version="0.0.869" />
    <!-- Stay on 2.x: EF Core 10 is built against SQLitePCLRaw 2.1.x. 2.1.14 never
         existed, so restore used to jump a major version to 3.0.0. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OsuScoutNew.Core\OsuScoutNew.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window icon, loaded at run time; the exe icon is ApplicationIcon above. -->
    <AvaloniaResource Include="Assets\scoutsu.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\ensemble_model_1.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\ensemble_model_2.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\ensemble_model_3.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\ensemble_model_4.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\ensemble_model_5.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\model_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
